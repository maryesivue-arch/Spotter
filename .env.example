# PostgreSQL connection (pooled, used by application runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotter?pgbouncer=true"

# PostgreSQL connection (direct, used for migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/spotter"

# Session cookie secret (32 random bytes hex / base64)
SESSION_SECRET="replace-with-secure-32-byte-secret"

# Gemini embedding API key
GEMINI_API_KEY="replace-with-gemini-api-key"

# Flutterwave credentials
FLUTTERWAVE_SECRET_KEY="replace-with-flutterwave-secret-key"
FLUTTERWAVE_WEBHOOK_SECRET="replace-with-flutterwave-webhook-secret"
